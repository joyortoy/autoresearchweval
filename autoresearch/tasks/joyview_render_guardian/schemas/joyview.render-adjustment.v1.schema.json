{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joyortoy.com/schemas/joyview.render-adjustment.v1.schema.json",
  "title": "JoyView Render Adjustment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "joyview.render-adjustment/v1"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "rationale_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
